---
import { UI_CONFIG } from '../data/ui-copy';
import '../styles/console.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Santiago Olayo | AI Assistant</title>
    <meta
      name="description"
      content="Interactive AI assistant for Santiago Olayo Villamil. Explore production backend architecture, integrations, or evaluate job vacancy fit."
    />
    <link rel="canonical" href="https://ai.santiago-jv.tech/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="header">
      <div class="header-inner">
        <a href="https://www.santiago-jv.tech" class="brand-link" aria-label="Santiago Olayo">
          <img src="/favicon.svg" alt="" width="26" height="26" class="brand-mark" />
          <span class="wordmark">Santiago Olayo</span>
          <span class="brand-tag">AI</span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
          <a href="https://mcp.santiago-jv.tech/docs" class="nav-link">MCP Docs</a>
          <a href="https://www.santiago-jv.tech" class="nav-cta">Portfolio</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="hero-header">
        <h1 class="hero-title">{UI_CONFIG.heroTitle}</h1>
        <p class="hero-subtitle">{UI_CONFIG.heroSubtitle}</p>
      </section>

      <section class="console-window" aria-label="AI Chat">
        <div class="window-bar">
          <div class="traffic-lights" aria-hidden="true">
            <span class="light"></span>
            <span class="light"></span>
            <span class="light"></span>
          </div>
          <span class="live-indicator">
            <span class="live-dot"></span>
            <span>@nestjs/ai</span>
          </span>
        </div>

        <div class="chat-stream" id="chat-stream" role="log" aria-live="polite">
          <div class="msg-row assistant">
            <div class="bubble">
              <p>{UI_CONFIG.welcomeBody}</p>
            </div>
          </div>
        </div>

        <div class="chips-row" id="chips-grid">
          {
            UI_CONFIG.chips.map((chip) => (
              <button type="button" class="chip-btn" data-prompt={chip.prompt}>
                {chip.label}
              </button>
            ))
          }
        </div>

        <form class="composer" id="chat-form">
          <input
            type="text"
            name="website"
            id="website-honeypot"
            class="honeypot-field"
            tabindex="-1"
            autocomplete="off"
          />
          <textarea
            id="chat-input"
            class="composer-textarea"
            rows="1"
            maxlength="2200"
            placeholder={UI_CONFIG.inputPlaceholder}
            required></textarea>
          <button type="submit" class="send-btn" id="send-btn">Send</button>
        </form>
      </section>
    </main>

    <script>
      import '../scripts/chat-client';
    </script>
  </body>
</html>
