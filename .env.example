# URL of the @nestjs/ai backend (deployed on Railway / Render / Vercel / Cloudflare)
NEST_AI_API_URL=https://api.santiago-jv.tech

# Shared 256-bit secret between ai.santiago-jv.tech and api.santiago-jv.tech
# Generate with: openssl rand -hex 32
INTERNAL_HMAC_SECRET=replace-with-64-char-hex-secret

# Allowed browser origins for /api/chat
ALLOWED_BROWSER_ORIGINS=https://ai.santiago-jv.tech,https://www.santiago-jv.tech
